# Safara App Environment Variables Example
# Copy this file to .env.local for local development or set these variables in your hosting provider (e.g. Vercel)

# Supabase (Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Payment Gateway (Xendit Escrow Integration)
XENDIT_SECRET_KEY=xnd_development_your_secret_key
XENDIT_PUBLIC_KEY=xnd_public_development_key
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token

# Platform URL
NEXT_PUBLIC_APP_URL=https://safara.id
